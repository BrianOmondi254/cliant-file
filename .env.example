# =============================================================================
# LOCAL: copy to .env in project root
# RENDER: Dashboard → Web Service → Environment → "Add from .env" or add each row
# =============================================================================

# --- Required for login / MongoDB ---
MONGODB_URI=mongodb+srv://YOUR_USER:YOUR_PASSWORD@YOUR_CLUSTER.mongodb.net/cliant_db?retryWrites=true&w=majority

# --- App (optional on Render — Render sets PORT automatically) ---
NODE_ENV=production
PORT=3000

# --- Session (not wired in server.js yet; safe to set for future use) ---
SESSION_SECRET=change-this-to-a-long-random-string
SECRET_KEY=change-this-secret

# --- MongoDB parts (optional — app uses MONGODB_URI only) ---
DB_USER=your_atlas_user
DB_PASSWORD=your_atlas_password
DB_NAME=cliant_db
DB_HOST=cluster0.xxxxx.mongodb.net
DB_PORT=27017

# --- M-Pesa (only if you use payments on production) ---
# MPESA_CONSUMER_KEY=
# MPESA_CONSUMER_SECRET=
# MPESA_SHORTCODE=
# MPESA_PASSKEY=
# MPESA_CALLBACK_URL=https://YOUR-SERVICE.onrender.com/api/mpesa/callback

# --- Pesapal (sandbox / production) ---
PESAPAL_ENVIRONMENT=sandbox
PESAPAL_CONSUMER_KEY=YOUR_PESAPAL_CONSUMER_KEY
PESAPAL_CONSUMER_SECRET=YOUR_PESAPAL_CONSUMER_SECRET
# After user pays on Pesapal, they are redirected back here. Set to your deployed base + /api/payment/pesapal/callback
PESAPAL_CALLBACK_URL=https://YOUR-SERVICE.onrender.com/api/payment/pesapal/callback
# Pesapal server-to-server payment notification URL. Set to your deployed base + /api/payment/pesapal/ipn
PESAPAL_IPN_URL=https://YOUR-SERVICE.onrender.com/api/payment/pesapal/ipn
# The IPN ID returned by Pesapal after you register your IPN URL above in their system.
# Do NOT make up a value here. To obtain one:
#   1) Start the server with PESAPAL_IPN_URL set.
#   2) POST { "ipnUrl": "https://YOUR-SERVICE.onrender.com/api/payment/pesapal/ipn", "notificationType": "GET" }
#      to /api/payment/pesapal/register-ipn
#   3) Read the `ipn_id` field from the response, OR call GET /api/payment/pesapal/ipn-list to see all registered IDs.
#   4) Paste that ipn_id value here and restart.
# If empty or invalid, payments still work via browser callback — only server-side IPN webhooks are skipped.
PESAPAL_IPN_ID=
