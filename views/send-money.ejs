<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Send Money - Group Account</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --primary: #0f9d58;
            --secondary: #7c3aed;
            --bg: #f8fafc;
            --card: #ffffff;
            --text: #1e293b;
            --border: #e2e8f0;
        }
        body {
            font-family: 'Inter', sans-serif;
            background: #f1f5f9;
            margin: 0;
            padding: 20px;
            display: flex;
            justify-content: center;
        }
        .container {
            width: 100%;
            max-width: 420px;
            background: var(--card);
            border-radius: 20px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            overflow: hidden;
        }
        .header {
            background: linear-gradient(135deg, var(--primary), #34d399);
            padding: 25px;
            color: white;
            text-align: center;
        }
        .content {
            padding: 25px;
        }
        .form-group {
            margin-bottom: 20px;
        }
        label {
            display: block;
            margin-bottom: 8px;
            font-weight: 600;
            font-size: 0.9rem;
            color: var(--text);
        }
        select, input {
            width: 100%;
            padding: 12px;
            border: 1px solid var(--border);
            border-radius: 10px;
            font-size: 1rem;
            outline: none;
        }
        button {
            width: 100%;
            padding: 14px;
            background: var(--primary);
            color: white;
            border: none;
            border-radius: 10px;
            font-weight: 600;
            cursor: pointer;
            margin-top: 10px;
        }
        .btn-secondary {
            background: #e2e8f0;
            color: #475569;
            margin-top: 10px;
        }
        .result-box {
            background: #f0fdf4;
            border: 1px solid #bbf7d0;
            padding: 20px;
            border-radius: 12px;
            text-align: center;
        }
    </style>
</head>
<body>
<div class="container">
    <div class="header">
        <h2><i class="fas fa-money-bill-transfer"></i> Deposit to Group</h2>
    </div>
    <div class="content">
        <% if (step === 'select-account') { %>
            <form action="/personal/send-money/details" method="POST">
                <div class="form-group">
                    <label>Select Target Group</label>
                    <select name="groupName" required>
                        <% groups.forEach(g => { %>
                            <option value="<%= g.groupName %>"><%= g.groupName %></option>
                        <% }) %>
                    </select>
                </div>
                <button type="submit">Continue <i class="fas fa-arrow-right"></i></button>
            </form>
        <% } else if (step === 'details') { %>
            <form action="/personal/send-money/submit" method="POST">
                <input type="hidden" name="groupName" value="<%= groupName %>">
                <div class="form-group">
                    <label>Select Target Account</label>
                    <select name="accountId" required>
                        <option value="001" selected>Saving Account (001)</option>
                        <option value="002">Registration Account (002)</option>
                        <option value="003">Lateness Account (003)</option>
                        <option value="004">Welfare Account (004)</option>
                    </select>
                </div>
                <div class="form-group">
                    <label>Amount (KES)</label>
                    <input type="number" name="amount" placeholder="0.00" required min="1">
                </div>
                <button type="submit">Verify Amount <i class="fas fa-check"></i></button>
            </form>
        <% } else if (step === 'confirm') { %>
            <div style="text-align: center;">
                <p>Transfer to: <strong><%= groupName %></strong> (Account: <strong><%= accountId || '001' %></strong>)</p>
                <h3 style="font-size: 2rem; color: var(--primary); margin: 10px 0;"><%= amount %></h3>
                <form action="/personal/send-money/complete" method="POST">
                    <input type="hidden" name="groupName" value="<%= groupName %>">
                    <input type="hidden" name="accountId" value="<%= accountId || '001' %>">
                    <input type="hidden" name="amount" value="<%= amount %>">
                    <button type="submit">Confirm Transfer</button>
                    <button type="button" class="btn-secondary" onclick="history.back()">Cancel</button>
                </form>
            </div>
        <% } else if (step === 'success') { %>
            <div class="result-box" style="text-align: left; padding: 20px; border-radius: 16px; background: #ffffff; border: 1px solid #e2e8f0; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                <% if (typeof result !== 'undefined' && result && result.fallback) { %>
                    <div style="text-align: center; margin-bottom: 15px;">
                        <i class="fas fa-wallet" style="font-size: 2.5rem; color: #f59e0b;"></i>
                        <h3 style="color: #92400e; margin: 10px 0 5px 0;">Credited to Personal Wallet</h3>
                        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Group roster verification was unverified. Funds were securely preserved in your Personal Wallet.</p>
                    </div>
                <% } else { %>
                    <div style="text-align: center; margin-bottom: 15px;">
                        <i class="fas fa-check-circle" style="font-size: 2.5rem; color: var(--primary);"></i>
                        <h3 style="color: #065f46; margin: 10px 0 5px 0;">Transaction Complete</h3>
                        <p style="color: #64748b; font-size: 0.88rem; margin: 0;">Group contribution recorded successfully.</p>
                    </div>
                <% } %>

                <div style="background: #f8fafc; border-radius: 12px; padding: 15px; margin: 15px 0; font-size: 0.88rem; border: 1px solid #edf2f7;">
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #64748b;">Amount:</span>
                        <strong style="color: #0f172a;"><%= amount %></strong>
                    </div>
                    <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                        <span style="color: #64748b;">Target Group:</span>
                        <strong style="color: #0f172a;"><%= groupName %></strong>
                    </div>
                    <% if (typeof result !== 'undefined' && result) { %>
                        <% if (result.statement?.accountName) { %>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="color: #64748b;">Account:</span>
                                <strong style="color: #0f172a;"><%= result.statement.accountName %> (<%= result.accountId || '001' %>)</strong>
                            </div>
                        <% } %>
                        <% if (result.circleRound) { %>
                            <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                                <span style="color: #64748b;">Active Round:</span>
                                <strong style="color: #059669;">Round #<%= result.circleRound %></strong>
                            </div>
                        <% } %>
                        <div style="display: flex; justify-content: space-between; margin-bottom: 8px;">
                            <span style="color: #64748b;">Reference:</span>
                            <strong style="color: #334155; font-family: monospace;"><%= result.statement?.reference || result.txId || 'TX-COMPLETED' %></strong>
                        </div>
                        <% if (result.statement?.closingBalance !== undefined) { %>
                            <div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px dashed #cbd5e1; margin-top: 6px;">
                                <span style="color: #64748b;">Wallet Balance:</span>
                                <strong style="color: var(--primary);">KSh <%= Number(result.statement.closingBalance).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></strong>
                            </div>
                        <% } else if (result.topUp?.balance !== undefined) { %>
                            <div style="display: flex; justify-content: space-between; padding-top: 8px; border-top: 1px dashed #cbd5e1; margin-top: 6px;">
                                <span style="color: #64748b;">Wallet Balance:</span>
                                <strong style="color: var(--primary);">KSh <%= Number(result.topUp.balance).toLocaleString('en-KE', { minimumFractionDigits: 2 }) %></strong>
                            </div>
                        <% } %>
                    <% } %>
                </div>

                <button onclick="window.location.href='/personal'" style="margin-top: 5px;">Return to Dashboard</button>
            </div>
        <% } %>
    </div>
</div>
</body>
</html>
