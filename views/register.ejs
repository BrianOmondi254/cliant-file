              <div class="rp-row" data-show-if="phoneNumber">
                <span class="rp-label">Phone Number</span>
                <span class="rp-value" id="paPhone"></span>
              </div>
              <div class="rp-row" data-show-if="paymentAccount">
                <span class="rp-label">Paying Account (M-Pesa)</span>
                <span class="rp-value green" id="paPaymentAccount"></span>
              </div>
              <div class="rp-row" data-show-if="idNumber">
                <span class="rp-label">ID Number</span>
                <span class="rp-value" id="paIdNumber"></span>
              </div>
              <div class="rp-row" data-show-if="gender">
                <span class="rp-label">Gender</span>
                <span class="rp-value" id="paGender"></span>
              </div>
              <div class="rp-row" data-show-if="ageBracket">
                <span class="rp-label">Age Bracket</span>
                <span class="rp-value" id="paAgeBracket"></span>
              </div>
              <div class="rp-row" data-show-if="county">
                <span class="rp-label">County</span>
                <span class="rp-value" id="paCounty"></span>
              </div>
              <div class="rp-row" data-show-if="constituency">
                <span class="rp-label">Constituency</span>
                <span class="rp-value" id="paConstituency"></span>
              </div>
              <div class="rp-row" data-show-if="ward">
                <span class="rp-label">Ward</span>
                <span class="rp-value" id="paWard"></span>
              </div>
              <div class="rp-row" data-show-if="amount">
                <span class="rp-label">Amount Paid</span>
                <span class="rp-value green" id="paAmount"></span>
              </div>
              <div class="rp-row" data-show-if="paymentMethodLabel">
                <span class="rp-label">Payment Method</span>
                <span class="rp-value" id="paPaymentMethod"></span>
              </div>
              <div class="rp-row" data-show-if="reference">
                <span class="rp-label">Reference ID</span>
                <span class="rp-value" style="font-size:11px;" id="paReference"></span>
              </div>
              <div class="rp-row" data-show-if="confirmationCode">
                <span class="rp-label">M-Pesa Confirmation</span>
                <span class="rp-value green" style="font-size:11px;" id="paConfirmationCode"></span>
              </div>
              <div class="rp-row" data-show-if="status">
                <span class="rp-label">Payment Status</span>
                <span class="rp-value green" id="paStatus"></span>
              </div>
            </div>
            <div class="rp-instruction">
              <strong>ℹ️ What happens next:</strong> Clicking Confirm will finalize your account, create your member profile in the county register, and record the registration fee as a transfer from the Registrar account to your Personal Account. No additional payment is needed.
            </div>
            <form id="pendingCompleteForm" action="/api/complete-from-pendingaccount" method="POST">
              <input type="hidden" name="pendingAccountId" id="paPendingAccountId">
              <input type="hidden" name="orderTrackingId" id="paOrderTrackingId">
              <input type="hidden" name="phoneNumber" id="paPhoneNumber">
              <button type="submit" class="rp-btn-confirm" id="pendingConfirmBtn">
                <span class="rp-btn-spinner"></span>
                <span>✓ Accept & Activate Account</span>
              </button>
            </form>
            <button type="button" class="rp-btn-dismiss" id="pendingDismissBtn">Not me — Dismiss</button>
          </div>
        `;
        document.body.appendChild(overlay);

        const fullName = [data.FirstName, data.MiddleName, data.LastName].filter(Boolean).join(' ').trim();
        const paymentMethodLabel = (function () {
          const raw = String(data.paymentMethod || '').toLowerCase();
          if (raw === 'pesapal' || raw === 'mpesa') return raw === 'mpesa' ? 'M-Pesa' : 'Pesapal';
          if (data.paymentAccount || data.confirmationCode) return 'M-Pesa';
          if (data.verificationNonce || data.orderTrackingId) return 'Pesapal';
          return '';
        })();
        const amountText = data.amount
          ? (Number(data.amount).toFixed(2).replace(/\.00$/, '') + ' ' + (data.currency || 'KES'))
          : '';
        const reference = data.orderTrackingId || data.merchantReference || '';

        document.getElementById('paFullName').textContent = fullName;
        document.getElementById('paEmail').textContent = data.email || '';
        document.getElementById('paPhone').textContent = data.phoneNumber || '';
        document.getElementById('paPaymentAccount').textContent = data.paymentAccount || '';
        document.getElementById('paIdNumber').textContent = data.idNumber || '';
        document.getElementById('paGender').textContent = data.gender || '';
        document.getElementById('paAgeBracket').textContent = data.ageBracket || '';
        document.getElementById('paCounty').textContent = data.county || '';
        document.getElementById('paConstituency').textContent = data.constituency || '';
        document.getElementById('paWard').textContent = data.ward || '';
        document.getElementById('paAmount').textContent = amountText;
        document.getElementById('paPaymentMethod').textContent = paymentMethodLabel;
        document.getElementById('paReference').textContent = reference;
        document.getElementById('paConfirmationCode').textContent = data.confirmationCode || '';
        document.getElementById('paStatus').textContent =
          (data.status && data.status.toUpperCase() !== 'INITIATED') ? data.status :
          (data.paymentStatusDescription || (amountText ? 'VERIFIED' : ''));
        document.getElementById('paPendingAccountId').value = data._id || '';
        document.getElementById('paOrderTrackingId').value = data.orderTrackingId || '';
        document.getElementById('paPhoneNumber').value = data.paymentAccount || data.phoneNumber || '';

        const values = {
          fullName, email: data.email, phoneNumber: data.phoneNumber,
          paymentAccount: data.paymentAccount, idNumber: data.idNumber,
          gender: data.gender, ageBracket: data.ageBracket,
          county: data.county, constituency: data.constituency, ward: data.ward,
          amount: amountText, paymentMethodLabel, reference,
          confirmationCode: data.confirmationCode,
          status: (data.status && data.status.toUpperCase() !== 'INITIATED') ? data.status :
                  (data.paymentStatusDescription || (amountText ? 'VERIFIED' : '')),
        };
        Array.prototype.forEach.call(
          document.getElementById('paDetails').querySelectorAll('.rp-row'),
          function (row) {
            const key = row.getAttribute('data-show-if');
            if (!key) return;
            const v = values[key];
            if (!v || String(v).trim() === '') row.style.display = 'none';
          }
        );

        document.getElementById('pendingDismissBtn').addEventListener('click', () => overlay.remove());
        const btn = document.getElementById('pendingConfirmBtn');
        const form = document.getElementById('pendingCompleteForm');
        form.addEventListener('submit', (e) => {
            e.preventDefault();
            btn.classList.add('loading');
            btn.disabled = true;
            const formData = new FormData(form);
            const payload = {};
            formData.forEach((v, k) => { payload[k] = v; });
            fetch(form.action, {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify(payload)
            })
            .then(r => r.json())
            .then(result => {
                if (result.success) {
                    window.location.href = '/login?message=Registration successful. Login now.';
                } else {
                    showToast(result.message || 'Failed to complete registration. Please try again.', 'error');
                    btn.classList.remove('loading');
                    btn.disabled = false;
                }
            })
            .catch(err => {
                console.error('[register] complete-from-pendingaccount error:', err);
                showToast('Network error. Please try again.', 'error');
                btn.classList.remove('loading');
                btn.disabled = false;
            });
        });
    }

    function showStep(step) {
        document.getElementById("step1").classList.toggle("hidden", step !== 1);
        document.getElementById("step2").classList.toggle("hidden", step !== 2);
        document.getElementById("step3").classList.toggle("hidden", step !== 3);
        setActiveDot(step);
    }

    function clearPasskeyCountdown() {
        if (passkeyCountdownTimer) {
            clearInterval(passkeyCountdownTimer);
            passkeyCountdownTimer = null;
        }
        passkeySecondsLeft = 0;
    }

    function formatPasskeyTimer(totalSeconds) {
        const m = Math.floor(totalSeconds / 60);
        const s = totalSeconds % 60;
        return m + ':' + String(s).padStart(2, '0');
    }

    function showPasskeySubstep(which) {
        document.getElementById('passkeyChannelStep').style.display = which === 'channel' ? 'block' : 'none';
        document.getElementById('passkeyVerifyStep').style.display = which === 'verify' ? 'block' : 'none';
        document.getElementById('passkeyExpiredStep').style.display = which === 'expired' ? 'block' : 'none';
    }

    function resetPasskeyUi() {
        clearPasskeyCountdown();
        passkeyChannel = null;
        const input = document.getElementById('passkeyInput');
        if (input) input.value = '';
        const msg = document.getElementById('passkeySendMsg');
        if (msg) {
            msg.textContent = '';
            msg.style.color = '#64748b';
        }
        showPasskeySubstep('channel');
    }

    function startPasskeyCountdown() {
        clearPasskeyCountdown();
        passkeySecondsLeft = PASSKEY_TTL_SECONDS;
        const timerEl = document.getElementById('passkeyTimer');
        const countdownEl = document.getElementById('passkeyCountdown');
        if (timerEl) timerEl.textContent = formatPasskeyTimer(passkeySecondsLeft);
        if (countdownEl) countdownEl.style.color = '#0f9d58';

        passkeyCountdownTimer = setInterval(() => {
            passkeySecondsLeft -= 1;
            if (timerEl) timerEl.textContent = formatPasskeyTimer(Math.max(0, passkeySecondsLeft));

            if (passkeySecondsLeft <= 30 && countdownEl) {
                countdownEl.style.color = '#b45309';
            }

            if (passkeySecondsLeft <= 0) {
                clearPasskeyCountdown();
                const input = document.getElementById('passkeyInput');
                if (input) input.value = '';
                showPasskeySubstep('expired');
            }
        }, 1000);
    }

    async function sendRegistrationPasskey(channel) {
        const email = document.querySelector('input[name="email"]').value.trim();
        const phoneNumber = document.querySelector('input[name="phoneNumber"]').value.trim();
        const sendMsg = document.getElementById('passkeySendMsg');
        const emailBtn = document.getElementById('sendPasskeyEmailBtn');
        const phoneBtn = document.getElementById('sendPasskeyPhoneBtn');

        if (channel === 'email' && !email) {
            showToast('Email address is required.', 'error');
            return;
        }
        if (channel === 'phone' && !phoneNumber) {
            showToast('Phone number is required.', 'error');
            return;
        }

        if (emailBtn) emailBtn.disabled = true;
        if (phoneBtn) phoneBtn.disabled = true;
        if (sendMsg) {
            sendMsg.style.color = '#64748b';
            sendMsg.textContent = channel === 'email' ? 'Sending to email…' : 'Sending to phone…';
        }

        try {
            const res = await fetch('/register/send-passkey', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ channel, email, phoneNumber })
            });
            const data = await res.json();

            if (!data.success) {
                if (sendMsg) {
                    sendMsg.style.color = '#dc2626';
                    sendMsg.textContent = data.message || 'Failed to send verification code.';
                } else {
                    showToast(data.message || 'Failed to send verification code.', 'error');
                }
                return;
            }

            passkeyChannel = channel;
            const dest = channel === 'email' ? email : phoneNumber;
            const hint = document.getElementById('passkeySentHint');
            if (hint) {
                hint.textContent = channel === 'email'
                    ? ('Code sent to your email (' + dest + '). Enter it below.')
                    : ('Code sent to your phone (' + dest + '). Enter it below.');
            }

            showPasskeySubstep('verify');
            startPasskeyCountdown();
            const input = document.getElementById('passkeyInput');
            if (input) {
                input.value = '';
                input.focus();
            }
            if (sendMsg) sendMsg.textContent = '';
        } catch (err) {
            console.error('sendRegistrationPasskey', err);
            if (sendMsg) {
                sendMsg.style.color = '#dc2626';
                sendMsg.textContent = 'Network error. Please try again.';
            } else {
                showToast('Network error. Please try again.', 'error');
            }
        } finally {
            if (emailBtn) emailBtn.disabled = false;
            if (phoneBtn) phoneBtn.disabled = false;
        }
    }

    async function handleNextStep() {
        const step1 = document.getElementById("step1");
        const step2 = document.getElementById("step2");

        // Step 1 → Step 2 (location)
        if (!step1.classList.contains("hidden")) {
            const name = document.getElementById("nameInput").value.trim();
            const email = document.querySelector('input[name="email"]').value;
            const pass = document.getElementById("password").value;
            const confirm = document.getElementById("confirmPassword").value;
            const phone = document.querySelector('input[name="phoneNumber"]').value;
            const gender = document.getElementById("genderSelect").value;

            if (name.split(/\s+/).filter(word => word.length > 0).length < 3) {
                document.getElementById('nameError').style.display = 'block';
                document.getElementById('nameInput').focus();
                return;
            } else {
                document.getElementById('nameError').style.display = 'none';
            }

            if (!name || !email || !pass || !confirm || !phone || !gender) {
                showToast("Please fill all required fields", 'error');
                return;
            }

            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (!emailRegex.test(email)) {
                showToast("Please enter a valid email address (e.g., user@example.com)", 'error');
                return;
            }

            if (pass !== confirm) {
                showToast("Passwords do not match", 'error');
                return;
            }

            const parts = name.split(/\s+/);
            document.getElementById("extFirstName").value = parts[0] || "";
            if (parts.length === 2) {
                document.getElementById("extLastName").value = parts[1];
            } else if (parts.length > 2) {
                document.getElementById("extMiddleName").value = parts.slice(1, -1).join(" ");
                document.getElementById("extLastName").value = parts[parts.length - 1];
            }

            const trimmedPhone = phone.trim();

            // 1. Check if phone already exists in County collection → redirect to login
            try {
                const countyRes = await fetch('/api/check-phone-county', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: trimmedPhone })
                });
                const countyData = await countyRes.json();
                if (countyData && countyData.found) {
                    showToast('Phone number already registered. Redirecting to login...', 'info');
                    window.setTimeout(function () { window.location.href = '/login'; }, 1000);
                    return;
                }
            } catch (err) {
                console.error('[register] check-phone-county failed:', err);
            }

            // 2. If NOT in County, check PendingAccount collection → show popup if found
            try {
                const pendingRes = await fetch('/api/check-phone-pendingaccount', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: trimmedPhone })
                });
                const pendingData = await pendingRes.json();
                if (pendingData && pendingData.found) {
                    showPendingAccountPopup(pendingData);
                    return;
                }
            } catch (err) {
                console.error('[register] check-phone-pendingaccount failed:', err);
            }

            // 3. Fallback: check for existing verified Pesapal payment session
            try {
                const res = await fetch('/api/check-payment-session', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ phone: trimmedPhone })
                });
                const data = await res.json();
                if (data && data.found) {
                    showResumePaymentPopup(data);
                    return;
                }
            } catch (err) {
                console.error('[register] check-payment-session failed:', err);
            }

            showStep(2);
            return;
        }

        // Step 2 → verify tbank personal_account_registration → Step 3
        if (!step2.classList.contains("hidden")) {
            const county = document.getElementById("countySelect").value;
            const constituency = document.getElementById("constituencySelect").value;
            const ward = document.getElementById("wardSelect").value;
            const ageBracket = document.querySelector('input[name="ageBracket"]:checked');

            if (!county || !constituency || !ward || !ageBracket) {
                showToast("Please complete all location and age bracket fields.", 'error');
                return;
            }

            await loadRegistrationStep();
        }
    }

    async function loadRegistrationStep() {
        try {
            const res = await fetch('/hq/compliance/data');
            const data = await res.json();

            if (!data.success || !data.data) {
                showToast("Unable to verify registration settings. Please try again.", 'error');
                return;
            }

            const reg = data.data.personal_account_registration || null;
            currentRegistration = reg;

            if (!reg || reg.amount === null || reg.amount === undefined || reg.amount === '' || !reg.paymentMethod) {
                document.getElementById('registerForm').submit();
                return;
            }

            const passkeySection = document.getElementById("passkeySection");
            const paymentSection = document.getElementById("paymentSection");
            const method = String(reg.paymentMethod).toLowerCase();

            passkeySection.style.display = "none";
            paymentSection.style.display = "none";

            if (method === 'passkey' || String(reg.amount) === '0') {
                resetPasskeyUi();
                passkeySection.style.display = "block";
            } else if (method === 'mpesa' || method === 'pesapal') {
                paymentSection.style.display = "block";
                const methodLabel = method === 'mpesa' ? 'M-Pesa' : 'Pesapal';
                document.getElementById('paymentAmount').textContent = reg.amount + ' KES';
                document.getElementById('paymentMethod').textContent = 'Payment Method: ' + methodLabel;
                document.getElementById('paymentNote').textContent =
                    'Registration fee is currently set to ' + reg.amount + ' KES via ' + methodLabel +
                    '. This fee may change based on Finance updates. Click Pay to continue.';
            } else {
                showToast("Unknown payment method configured. Please contact support.", 'error');
                return;
            }

            showStep(3);
        } catch (err) {
            console.error("Error checking registration settings:", err);
            showToast("Unable to load registration settings. Please try again.", 'error');
        }
    }

    async function submitWithPasskey() {
        if (passkeySecondsLeft <= 0) {
            showToast("Verification code expired. Please resend a new code.", 'error');
            showPasskeySubstep('expired');
            return;
        }

        const passkey = document.getElementById('passkeyInput').value.trim();
        if (!passkey) {
            showToast("Please enter the passkey", 'error');
            return;
        }

        const form = document.getElementById('registerForm');
        let existingPasskeyInput = document.getElementById('existingPasskey');
        if (!existingPasskeyInput) {
            existingPasskeyInput = document.createElement('input');
            existingPasskeyInput.type = 'hidden';
            existingPasskeyInput.name = 'passkey';
            existingPasskeyInput.id = 'existingPasskey';
            form.appendChild(existingPasskeyInput);
        }
        existingPasskeyInput.value = passkey;
        clearPasskeyCountdown();
        form.submit();
    }

    function startRegistrationPayment() {
        if (!currentRegistration) {
            showToast("Registration fee settings not loaded.", 'error');
            return;
        }
        const method = String(currentRegistration.paymentMethod || '').toLowerCase();
        console.log('[register] Pay clicked with method:', method, currentRegistration);

        const payBtn = document.getElementById('payBtn');
        if (payBtn) {
            payBtn.disabled = true;
            const originalText = payBtn.textContent;
            payBtn.textContent = 'Preparing payment...';
        }

        const form = document.getElementById('registerForm');
        if (!form) {
            showToast("Registration form not found. Please try again.", 'error');
            if (payBtn) { payBtn.disabled = false; payBtn.textContent = originalText; }
            return;
        }

        if (method === 'pesapal') {
            try {
                const fd = new FormData(form);
                const payload = {};
                fd.forEach((v, k) => { payload[k] = v; });
                payload.passkey = '';

                fetch('/api/payment/pesapal/initiate', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({
                        amount: currentRegistration.amount,
                        registrationData: JSON.stringify(payload)
                    })
                })
                .then(r => r.json())
                .then(data => {
                    if (data && data.success && data.redirect_url) {
                        window.location.href = data.redirect_url;
                    } else {
                        showToast(data?.message || 'Failed to initiate Pesapal payment. Falling back to confirmation page...', 'error');
                        window.setTimeout(function () { form.submit(); }, 1500);
                    }
                })
                .catch(err => {
                    console.error('[register] Pesapal initiate error:', err);
                    showToast('Network error initiating Pesapal. Falling back to confirmation page.', 'error');
                    window.setTimeout(function () { form.submit(); }, 1500);
                })
                .finally(() => {
                    if (payBtn) { payBtn.disabled = false; payBtn.textContent = 'Pay'; }
                });
                return;
            } catch (e) {
                console.error('[register] Building Pesapal payload failed:', e);
            }
        }

        form.submit();
    }

    function goBackToStep1() {
        resetPasskeyUi();
        showStep(1);
        document.getElementById("countySelect").value = "";
        document.getElementById("constituencySelect").innerHTML = '<option value="" disabled selected>-- Select Constituency --</option>';
        document.getElementById("wardSelect").innerHTML = '<option value="" disabled selected>-- Select Ward --</option>';
        document.querySelectorAll('input[name="ageBracket"]').forEach(r => r.checked = false);
    }

    function goBackToStep2() {
        resetPasskeyUi();
        document.getElementById("passkeySection").style.display = "none";
        document.getElementById("paymentSection").style.display = "none";
        currentRegistration = null;
        showStep(2);
    }

    // Location helpers
    let countiesLoaded = false;

    async function initCounties() {
        if (countiesLoaded) return;
        const select = document.getElementById("countySelect");
        try {
            const res = await fetch('/api/locations/counties');
            const counties = await res.json();
            counties.forEach(c => {
                const opt = document.createElement("option");
                opt.value = c;
                opt.textContent = c;
                select.appendChild(opt);
            });
            countiesLoaded = true;
        } catch (e) {
            console.error("Failed to load counties", e);
        }
    }

    function loadConstituencies() {
        const county = document.getElementById("countySelect").value;
        const consSelect = document.getElementById("constituencySelect");
        const wardSelect = document.getElementById("wardSelect");

        consSelect.innerHTML = '<option value="" disabled selected>-- Select Constituency --</option>';
        wardSelect.innerHTML = '<option value="" disabled selected>-- Select Ward --</option>';

        if (!county) return;

        fetch(`/api/locations/${encodeURIComponent(county)}/constituencies`)
            .then(r => r.json())
            .then(list => {
                list.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item;
                    opt.textContent = item;
                    consSelect.appendChild(opt);
                });
            })
            .catch(e => console.error(e));
    }

    function loadWards() {
        const county = document.getElementById("countySelect").value;
        const cons = document.getElementById("constituencySelect").value;
        const wardSelect = document.getElementById("wardSelect");

        wardSelect.innerHTML = '<option value="" disabled selected>-- Select Ward --</option>';
        if (!county || !cons) return;

        fetch(`/api/locations/${encodeURIComponent(county)}/${encodeURIComponent(cons)}/wards`)
            .then(r => r.json())
            .then(list => {
                list.forEach(item => {
                    const opt = document.createElement("option");
                    opt.value = item;
                    opt.textContent = item;
                    wardSelect.appendChild(opt);
                });
            })
            .catch(e => console.error(e));
    }

    // Dynamic Phone Validation
    const phoneInput = document.getElementById('phoneInput');
    if (phoneInput) {
        phoneInput.addEventListener('input', function() {
            let val = this.value.replace(/[^0-9]/g, '').trim();
            this.value = val;
            if (val.startsWith('254')) {
                this.maxLength = 12;
            } else if (val.startsWith('07') || val.startsWith('01')) {
                this.maxLength = 10;
            } else {
                this.maxLength = 13;
            }
        });
    }
</script>

